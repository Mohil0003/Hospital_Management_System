@model DataTable
@using System.Data

<!-- Bootstrap Icons -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">

<div class="container mt-4">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white d-flex flex-wrap gap-3 align-items-center" style="border-top-left-radius:16px;border-top-right-radius:16px;">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-person-badge text-primary fs-5"></i>
                <h5 class="mb-0 fw-semibold">Doctors</h5>
            </div>
            <div class="ms-auto d-flex flex-wrap gap-2">
                <div class="input-group input-group-sm" style="width:260px;">
                    <span class="input-group-text bg-light"><i class="bi bi-search"></i></span>
                    <input type="text" class="form-control" placeholder="Search doctors..." data-table-search="#doctorsTable" />
                </div>
                <a asp-controller="Doctor" asp-action="Index" class="btn btn-primary btn-sm">
                    <i class="bi bi-plus-circle me-1"></i> Add Doctor
                </a>
                <a class="btn btn-outline-success btn-sm"
                   asp-controller="Doctor"
                   asp-action="ExportToExcel">
                    <i class="bi bi-download me-1"></i> Export
                </a>
            </div>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table id="doctorsTable" class="table table-striped table-hover align-middle text-center mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Name</th>
                            <th>Email</th>
                            <th>Phone</th>
                            <th>Qualification</th>
                            <th>Specialization</th>
                            <th>Status</th>
                            <th>Created</th>
                            <th>Modified</th>
                            <th style="width: 100px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (DataRow row in Model.Rows)
                        {
                            <tr>
                                <td>@row["Name"]</td>
                                <td>@row["Email"]</td>
                                <td>@row["Phone"]</td>
                                <td>@row["Qualification"]</td>
                                <td>@row["Specialization"]</td>
                                <td>
                                    @if (Convert.ToBoolean(row["IsActive"]))
                                    {
                                        <span class="badge bg-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Inactive</span>
                                    }
                                </td>
                                <td>@Convert.ToDateTime(row["Created"]).ToString("yyyy-MM-dd")</td>
                                <td>@Convert.ToDateTime(row["Modified"]).ToString("yyyy-MM-dd")</td>
                                <td>
                                    <div class="d-flex justify-content-center gap-2">
                                        <a asp-controller="Doctor"
                                           asp-action="Edit"
                                           asp-route-DoctorID="@row["DoctorID"]"
                                           class="btn btn-sm btn-outline-warning"
                                           title="Edit">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>
                                        <a asp-controller="Doctor"
                                           asp-action="DoctorDelete"
                                           asp-route-DoctorID="@row["DoctorID"]"
                                           class="btn btn-sm btn-outline-danger"
                                           title="Delete"
                                           >
                                            <i class="bi bi-trash3-fill"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
