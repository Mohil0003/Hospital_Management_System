@model DataTable
@using System.Data

<!-- Bootstrap Icons -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">

<div class="container mt-4">
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white d-flex flex-wrap gap-3 align-items-center" style="border-top-left-radius:16px;border-top-right-radius:16px;">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-person-hearts text-danger fs-5"></i>
                <h5 class="mb-0 fw-semibold">Patients</h5>
            </div>
            <div class="ms-auto d-flex flex-wrap gap-2">
                <div class="input-group input-group-sm" style="width:260px;">
                    <span class="input-group-text bg-light"><i class="bi bi-search"></i></span>
                    <input type="text" class="form-control" placeholder="Search patients..." data-table-search="#patientsTable" />
                </div>
                <a asp-controller="Patient" asp-action="Index" class="btn btn-primary btn-sm">
                    <i class="bi bi-plus-circle me-1"></i> Add Patient
                </a>
                <a class="btn btn-outline-success btn-sm"
                   asp-controller="Patient"
                   asp-action="ExportToExcel">
                    <i class="bi bi-download me-1"></i> Export
                </a>
            </div>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table id="patientsTable" class="table table-striped table-hover align-middle text-center mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>Name</th>
                            <th>DOB</th>
                            <th>Gender</th>
                            <th>Email</th>
                            <th>Phone</th>
                            <th>City</th>
                            <th>State</th>
                            <th>Status</th>
                            <th>Created</th>
                            <th>Modified</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Rows.Count == 0)
                        {
                            <tr>
                                <td colspan="11" class="text-muted text-center py-3">No patients found.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (DataRow row in Model.Rows)
                            {
                                <tr>
                                    <td class="fw-semibold">@row["Name"]</td>
                                    <td>@Convert.ToDateTime(row["DateOfBirth"]).ToString("yyyy-MM-dd")</td>
                                    <td>@row["Gender"]</td>
                                    <td>@row["Email"]</td>
                                    <td>@row["Phone"]</td>
                                    <td>@row["City"]</td>
                                    <td>@row["State"]</td>
                                    <td>
                                        @if (Convert.ToBoolean(row["IsActive"]))
                                        {
                                            <span class="badge bg-success px-3 py-2">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger px-3 py-2">Inactive</span>
                                        }
                                    </td>
                                    <td>@Convert.ToDateTime(row["Created"]).ToString("yyyy-MM-dd")</td>
                                    <td>@Convert.ToDateTime(row["Modified"]).ToString("yyyy-MM-dd")</td>
                                    <td>
                                        <div class="d-flex justify-content-center gap-2">
                                            <a asp-controller="Patient"
                                               asp-action="Edit"
                                               asp-route-PatientID="@row["PatientID"]"
                                               class="btn btn-sm btn-outline-warning"
                                               title="Edit">
                                                <i class="bi bi-pencil-square"></i>
                                            </a>
                                            <a asp-controller="Patient"
                                               asp-action="PatientDelete"
                                               asp-route-PatientID="@row["PatientID"]"
                                               class="btn btn-sm btn-outline-danger js-delete"
                                               data-title="Delete patient?"
                                               data-text="This patient will be permanently deleted."
                                               title="Delete">
                                                <i class="bi bi-trash3-fill"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
