 @model DataTable
@using System.Data

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">

<div class="container mt-4">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white d-flex flex-wrap gap-3 align-items-center" style="border-top-left-radius:16px;border-top-right-radius:16px;">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-diagram-3 text-primary fs-5"></i>
                <h5 class="mb-0 fw-semibold">Doctor-Department</h5>
            </div>
            <div class="ms-auto d-flex flex-wrap gap-2">
                <div class="input-group input-group-sm" style="width:260px;">
                    <span class="input-group-text bg-light"><i class="bi bi-search"></i></span>
                    <input type="text" class="form-control" placeholder="Search mappings..." data-table-search="#docDeptTable" />
                </div>
                <a asp-controller="DoctorDepartment" asp-action="Index" class="btn btn-primary btn-sm">
                    <i class="bi bi-plus-circle me-1"></i> Add Mapping
                </a>
                <a class="btn btn-outline-success btn-sm"
                   asp-controller="DoctorDepartment"
                   asp-action="ExportToExcel">
                    <i class="bi bi-download me-1"></i> Export
                </a>
            </div>
        </div>

        <div class="card-body p-0">
            <div class="table-responsive">
                <table id="docDeptTable" class="table table-striped table-hover text-center align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>Doctor Name</th>
                            <th>Department Name</th>
                            <th>Created By</th>
                            <th>Created</th>
                            <th>Modified</th>
                            <th style="width: 120px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Rows.Count == 0)
                        {
                            <tr>
                                <td colspan="6" class="text-muted py-3">No mappings found.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (DataRow row in Model.Rows)
                            {
                                <tr>
                                    <td>@row["DoctorName"]</td>
                                    <td>@row["DepartmentName"]</td>
                                    <td>@row["UserName"]</td>
                                    <td>@Convert.ToDateTime(row["Created"]).ToString("yyyy-MM-dd")</td>
                                    <td>@Convert.ToDateTime(row["Modified"]).ToString("yyyy-MM-dd")</td>
                                    <td>
                                        <div class="d-flex justify-content-center gap-2">
                                            <a asp-controller="DoctorDepartment"
                                               asp-action="Edit"
                                               asp-route-DoctorDepartmentID="@row["DoctorDepartmentID"]"
                                               class="btn btn-sm btn-outline-warning" title="Edit">
                                                <i class="bi bi-pencil-square"></i>
                                            </a>
                                            <a asp-controller="DoctorDepartment"
                                               asp-action="DoctorDepartmentDelete"
                                               asp-route-DoctorDepartmentID="@row["DoctorDepartmentID"]"
                                               class="btn btn-sm btn-outline-danger js-delete" title="Delete"
                                               data-title="Delete mapping?"
                                               data-text="This mapping will be permanently deleted.">
                                                <i class="bi bi-trash3-fill"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
