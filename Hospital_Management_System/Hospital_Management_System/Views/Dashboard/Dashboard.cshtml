@model Hospital_Management_System.Models.DashboardModel
@{
    ViewData["Title"] = "Dashboard";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<div class="container py-4">
    <!-- Hospital Header -->
    <div class="text-center mb-4">
        <h1 class="display-6 fw-bold text-primary">CityCare Hospital</h1>
        <p class="lead text-muted">Healing Hands, Caring Hearts</p>
        <hr class="w-25 mx-auto">
    </div>

    <!-- Dashboard Heading -->
    <div class="d-flex align-items-center mb-4">
        <div class="me-3">
            <div class="bg-primary text-white rounded-3 p-3">
                <i class="bi bi-speedometer2 fs-4"></i>
            </div>
        </div>
        <div>
            <h2 class="h3 fw-bold text-dark mb-1">Dashboard Overview</h2>
            <p class="text-muted mb-0">Monitor your hospital's performance and key metrics</p>
        </div>
    </div>

            
    <!-- Welcome + Quick Stats (Redesigned) -->
    
    <div class="row g-4 align-items-stretch mb-2">
        <div class="col-lg-8">
            <div class="card shadow-lg rounded-4 border-0 h-100" style="background: linear-gradient(135deg, #f8fafc 0%, #e2e8f0 100%); border-left: 4px solid #3b82f6 !important;">
                <div class="card-body p-4">
                    <div class="row g-4 align-items-center">
                        <!-- Left Content -->
                        <div class="col-lg-8">
                            <div class="d-flex align-items-center mb-3">
                                <div class="me-3">
                                    <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                                        <i class="bi bi-person-check fs-5"></i>
                                    </div>
                                </div>
                                <div>
                                    <h4 class="fw-bold mb-1 text-dark">Welcome back, Administrator</h4>
                                    <p class="text-muted mb-0 small">Here's your daily overview</p>
                                </div>
                            </div>
                            
                            <!-- Quick Stats Grid -->
                            <div class="row g-3 mb-4">
                                <div class="col-6">
                                    <div class="bg-white rounded-3 p-3 shadow-sm border-0">
                                        <div class="d-flex align-items-center">
                                            <div class="bg-primary bg-opacity-10 rounded-2 p-2 me-3">
                                                <i class="bi bi-calendar2-week text-primary fs-6"></i>
                                            </div>
                                            <div>
                                                <div class="text-muted small">Today's Appointments</div>
                                                <div class="h5 mb-0 fw-bold text-primary">@Model.TodaysAppointments</div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="bg-white rounded-3 p-3 shadow-sm border-0">
                                        <div class="d-flex align-items-center">
                                            <div class="bg-success bg-opacity-10 rounded-2 p-2 me-3">
                                                <i class="bi bi-people text-success fs-6"></i>
                                            </div>
                                            <div>
                                                <div class="text-muted small">Total Patients</div>
                                                <div class="h5 mb-0 fw-bold text-success">@Model.TotalPatients</div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            
                            <!-- Today's Insights -->
                            <div class="bg-white rounded-3 p-3 mb-4 shadow-sm">
                                <h6 class="fw-semibold text-dark mb-3">
                                    <i class="bi bi-lightbulb text-warning me-2"></i>Today's Insights
                                </h6>
                                <div class="row g-2">
                                    <div class="col-6">
                                        <div class="d-flex align-items-center">
                                            <div class="bg-info bg-opacity-10 rounded-2 p-2 me-2">
                                                <i class="bi bi-clock text-info fs-6"></i>
                                            </div>
                                            <div>
                                                <div class="small text-muted">Pending</div>
                                                <div class="fw-bold text-info">@Model.PendingAppointments</div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <div class="d-flex align-items-center">
                                            <div class="bg-success bg-opacity-10 rounded-2 p-2 me-2">
                                                <i class="bi bi-check-circle text-success fs-6"></i>
                                            </div>
                                            <div>
                                                <div class="small text-muted">Completed</div>
                                                <div class="fw-bold text-success">@Model.CompletedAppointments</div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            
                            <!-- Action Buttons -->
                            <div class="d-flex gap-3">
                                <a asp-controller="Appointment" asp-action="Index" class="btn btn-primary rounded-pill px-4 py-2 fw-semibold">
                                    <i class="bi bi-plus-circle me-2"></i>New Appointment
                                </a>
                                <a asp-controller="Appointment" asp-action="AppointmentList" class="btn btn-outline-primary rounded-pill px-4 py-2 fw-semibold">
                                    <i class="bi bi-list-ul me-2"></i>View Appointments
                                </a>
                            </div>
                        </div>
                        
                        <!-- Right Content - Mini Chart -->
                        <div class="col-lg-4">
                            <div class="text-center">
                                <div class="bg-white rounded-4 p-4 shadow-sm">
                                    <h6 class="text-muted mb-3 small fw-semibold">Appointment Progress</h6>
                                    <div class="position-relative" style="width: 120px; height: 120px; margin: 0 auto;">
                                        <canvas id="miniProgressChart" width="120" height="120"></canvas>
                                        <div class="position-absolute top-50 start-50 translate-middle text-center">
                                            <div class="h4 mb-0 fw-bold text-primary">@Model.CompletionRatePercent%</div>
                                            <div class="small text-muted">Complete</div>
                                        </div>
                                    </div>
                                    <div class="mt-3">
                                        <div class="d-flex justify-content-between small text-muted">
                                            <span>Completed: @Model.CompletedAppointments</span>
                                            <span>Pending: @Model.PendingAppointments</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="d-grid gap-3 h-100">
                <div class="card shadow rounded-4 border-0">
                    <div class="card-body d-flex align-items-center gap-3">
                        <div class="icon-box bg-success text-white rounded-circle d-flex align-items-center justify-content-center" style="width:60px; height:60px;">
                            <i class="bi bi-person-badge fs-5"></i>
                        </div>
                        <div>
                            <div class="text-muted small">Doctors</div>
                            <div class="h4 mb-0 fw-bold">@Model.TotalDoctors</div>
                        </div>
                    </div>
                </div>
                <div class="card shadow rounded-4 border-0">
                    <div class="card-body d-flex align-items-center gap-3">
                        <div class="icon-box bg-danger text-white rounded-circle d-flex align-items-center justify-content-center" style="width:60px; height:60px;">
                            <i class="bi bi-hospital fs-5"></i>
                        </div>
                        <div>
                            <div class="text-muted small">Patients</div>
                            <div class="h4 mb-0 fw-bold">@Model.TotalPatients</div>
                        </div>
                    </div>
                </div>
                <div class="card shadow rounded-4 border-0" style="background: linear-gradient(135deg, #eef2ff, #e0e7ff);">
                    <div class="card-body">
                        <div class="d-flex align-items-center gap-3 mb-2">
                            <div class="icon-box bg-primary text-white rounded-circle d-flex align-items-center justify-content-center" style="width:60px; height:60px;">
                                <i class="bi bi-currency-rupee fs-5"></i>
                            </div>
                            <div>
                                <div class="text-muted small">Total Revenue</div>
                                <div class="h4 mb-0 fw-bold">₹ @Model.TotalRevenue.ToString("N0")</div>
                            </div>
                        </div>
                        <div class="d-flex justify-content-between mt-2">
                            <div>
                                <div class="text-muted small">Revenue / Patient</div>
                                <div class="h6 fw-bold mb-0">₹ @Model.AvgRevenuePerPatient.ToString("N0")</div>
                            </div>
                            <div class="text-end">
                                <div class="text-muted small">Revenue / Appointment</div>
                                <div class="h6 fw-bold mb-0">₹ @Model.AvgRevenuePerAppointment.ToString("N0")</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Insights (Dynamic) -->
    <div class="row g-4 mt-1">
        <div class="col-md-3">
            <div class="card shadow rounded-4 border-0">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-3">
                        <div class="bg-warning bg-opacity-10 rounded-3 p-2 me-3">
                            <i class="bi bi-clock text-warning fs-4"></i>
                        </div>
                        <div>
                            <div class="text-muted small">Pending Appointments</div>
                            <div class="h3 fw-bold text-warning">@Model.PendingAppointments</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow rounded-4 border-0">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-3">
                        <div class="bg-success bg-opacity-10 rounded-3 p-2 me-3">
                            <i class="bi bi-check-circle text-success fs-4"></i>
                        </div>
                        <div>
                            <div class="text-muted small">Completed Appointments</div>
                            <div class="h3 fw-bold text-success">@Model.CompletedAppointments</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow rounded-4 border-0">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-3">
                        <div class="bg-danger bg-opacity-10 rounded-3 p-2 me-3">
                            <i class="bi bi-x-circle text-danger fs-4"></i>
                        </div>
                        <div>
                            <div class="text-muted small">Cancelled Appointments</div>
                            <div class="h3 fw-bold text-danger">@Model.CancelledAppointments</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow rounded-4 border-0">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-3">
                        <div class="bg-primary bg-opacity-10 rounded-3 p-2 me-3">
                            <i class="bi bi-graph-up text-primary fs-4"></i>
                        </div>
                        <div>
                            <div class="text-muted small">Completion Rate</div>
                            <div class="h3 fw-bold text-primary">@Model.CompletionRatePercent%</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Appointment Status + Charts -->
    <div class="row mt-3">
        <div class="col-lg-6 mb-3">
            <div class="card shadow rounded-4 p-3 h-100">
                <h6 class="fw-bold mb-2">Appointment Status Overview</h6>
                <div class="chart-container" style="height:260px; position:relative;">
                    <canvas id="statusChart" style="width:100%; height:100% !important;"></canvas>
                </div>
            </div>
        </div>
        <!-- Line Chart -->
        <div class="col-lg-6 mb-3">
            <div class="card shadow rounded-4 p-3">
                <h6 class="fw-bold text-primary mb-2">📈 Patients Growth (Monthly)</h6>
                <div class="chart-container" style="height:260px; position:relative;">
                    <canvas id="patientsChart" style="width:100%; height:100% !important;"></canvas>
                </div>
            </div>
        </div>

        <!-- Pie Chart -->
        <div class="col-lg-6 mb-3">
            <div class="card shadow rounded-4 p-3">
                <h6 class="fw-bold text-success mb-2">🩺 Appointments by Department</h6>
                <div class="chart-container" style="height:260px; position:relative;">
                    <canvas id="appointmentsChart" style="width:100%; height:100% !important;"></canvas>
                </div>
            </div>
        </div>

        <!-- Bar Chart -->
        <div class="col-lg-12 mb-3">
            <div class="card shadow rounded-4 p-3">
                <h6 class="fw-bold text-warning mb-2">💰 Revenue Analysis (Quarterly)</h6>
                <div class="chart-container" style="height:280px; position:relative;">
                    <canvas id="revenueChart" style="width:100%; height:100% !important;"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        // Create mini progress chart
        createMiniProgressChart();
        
        fetch('/Dashboard/GetChartData')
            .then(res => res.json())
            .then(data => {
                console.log('Chart data received:', data); // Debug log
                
                // Patients Growth Line Chart
                if (data.patientsGrowth && data.patientsGrowth.length > 0) {
                    new Chart(document.getElementById('patientsChart'), {
                        type: 'line',
                        data: {
                            labels: data.patientsGrowth.map(x => x.month ?? x.Month),
                            datasets: [{
                                label: 'Patients',
                                data: data.patientsGrowth.map(x => x.count ?? x.Count ?? x.TotalPatients),
                                borderColor: '#2563eb',
                                backgroundColor: 'rgba(37,99,235,0.1)',
                                tension: 0.4,
                                fill: true
                            }]
                        },
                        options: { 
                            plugins: { legend: { display: false } },
                            responsive: true,
                            maintainAspectRatio: false
                        }
                    });
                }

                // Appointments by Department Pie Chart
                if (data.appointmentsByDept && data.appointmentsByDept.length > 0) {
                    new Chart(document.getElementById('appointmentsChart'), {
                        type: 'pie',
                        data: {
                            labels: data.appointmentsByDept.map(x => x.department ?? x.Department ?? x.DepartmentName),
                            datasets: [{
                                data: data.appointmentsByDept.map(x => x.count ?? x.Count ?? x.TotalAppointments),
                                backgroundColor: ['#60a5fa', '#a78bfa', '#34d399', '#fbbf24', '#f87171', '#a3a3a3']
                            }]
                        },
                        options: { 
                            plugins: { legend: { position: 'bottom' } },
                            responsive: true,
                            maintainAspectRatio: false
                        }
                    });
                }

                // Revenue Analysis Bar Chart
                if (data.revenueAnalysis && data.revenueAnalysis.length > 0) {
                    new Chart(document.getElementById('revenueChart'), {
                        type: 'bar',
                        data: {
                            labels: data.revenueAnalysis.map(x => x.quarter ?? x.Quarter),
                            datasets: [{
                                label: 'Revenue (₹)',
                                data: data.revenueAnalysis.map(x => x.revenue ?? x.Revenue ?? x.TotalRevenue),
                                backgroundColor: '#f59e0b'
                            }]
                        },
                        options: { 
                            plugins: { legend: { display: false } },
                            responsive: true,
                            maintainAspectRatio: false
                        }
                    });
                }

                // Appointment Status Overview
                if (data.appointmentStatus && data.appointmentStatus.length > 0) {
                    new Chart(document.getElementById('statusChart'), {
                        type: 'doughnut',
                        data: {
                            labels: data.appointmentStatus.map(x => x.status ?? x.Status ?? x.AppointmentStatus),
                            datasets: [{
                                data: data.appointmentStatus.map(x => x.count ?? x.Count),
                                backgroundColor: ['#60a5fa', '#34d399', '#f87171']
                            }]
                        },
                        options: {
                            plugins: { 
                                legend: { position: 'bottom' },
                                tooltip: {
                                    callbacks: {
                                        label: function(context) {
                                            const total = context.dataset.data.reduce((a, b) => a + b, 0);
                                            const percentage = ((context.parsed / total) * 100).toFixed(1);
                                            return context.label + ': ' + context.parsed + ' (' + percentage + '%)';
                                        }
                                    }
                                }
                            },
                            responsive: true,
                            maintainAspectRatio: false
                        }
                    });
                } else {
                    // Fallback if no data
                    new Chart(document.getElementById('statusChart'), {
                        type: 'doughnut',
                        data: {
                            labels: ['Scheduled', 'Completed'],
                            datasets: [{
                                data: [60, 40],
                                backgroundColor: ['#60a5fa', '#34d399']
                            }]
                        },
                        options: {
                            plugins: { legend: { position: 'bottom' } },
                            responsive: true,
                            maintainAspectRatio: false
                        }
                    });
                }
            })
            .catch(error => {
                console.error('Error fetching chart data:', error);
                // Show fallback charts with sample data
                showFallbackCharts();
            });
    });

    function showFallbackCharts() {
        // Fallback Patients Growth
        new Chart(document.getElementById('patientsChart'), {
            type: 'line',
            data: {
                labels: ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun'],
                datasets: [{
                    label: 'Patients',
                    data: [120, 150, 180, 200, 220, 250],
                    borderColor: '#2563eb',
                    backgroundColor: 'rgba(37,99,235,0.1)',
                    tension: 0.4,
                    fill: true
                }]
            },
            options: { 
                plugins: { legend: { display: false } },
                responsive: true,
                maintainAspectRatio: false
            }
        });

        // Fallback Appointments by Department
        new Chart(document.getElementById('appointmentsChart'), {
            type: 'pie',
            data: {
                labels: ['Cardiology', 'Neurology', 'Orthopedics', 'Pediatrics'],
                datasets: [{
                    data: [25, 20, 30, 25],
                    backgroundColor: ['#60a5fa', '#a78bfa', '#34d399', '#fbbf24']
                }]
            },
            options: { 
                plugins: { legend: { position: 'bottom' } },
                responsive: true,
                maintainAspectRatio: false
            }
        });

        // Fallback Revenue Analysis
        new Chart(document.getElementById('revenueChart'), {
            type: 'bar',
            data: {
                labels: ['Q1 2024', 'Q2 2024', 'Q3 2024', 'Q4 2024'],
                datasets: [{
                    label: 'Revenue (₹)',
                    data: [500000, 600000, 700000, 800000],
                    backgroundColor: '#f59e0b'
                }]
            },
            options: { 
                plugins: { legend: { display: false } },
                responsive: true,
                maintainAspectRatio: false
            }
        });
    }

    function createMiniProgressChart() {
        const ctx = document.getElementById('miniProgressChart');
        if (!ctx) return;
        
        const completed = @Model.CompletedAppointments;
        const pending = @Model.PendingAppointments;
        const total = completed + pending;
        const completionRate = total > 0 ? (completed / total) * 100 : 0;
        
        new Chart(ctx, {
            type: 'doughnut',
            data: {
                datasets: [{
                    data: [completed, pending],
                    backgroundColor: ['#3b82f6', '#e5e7eb'],
                    borderWidth: 0,
                    cutout: '70%'
                }]
            },
            options: {
                responsive: false,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        display: false
                    },
                    tooltip: {
                        enabled: false
                    }
                }
            }
        });
    }
</script>