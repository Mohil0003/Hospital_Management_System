    @model Hospital_Management_System.Models.DashboardModel
    @{
        ViewData["Title"] = "Dashboard";
    }

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

    <div class="container py-2">
        <div class="row g-4 justify-content-center">

            <!-- Users -->
            <div class="col-md-6 col-lg-4">
                <div class="card shadow rounded-4 p-3 border-0 d-flex flex-row align-items-center">
                    <div class="icon-box bg-primary text-white rounded-circle d-flex align-items-center justify-content-center me-3" style="width:70px; height:70px;">
                        <i class="bi bi-people-fill fs-3"></i>
                    </div>
                    <div>
                        <h6 class="mb-1 text-muted">Total Users</h6>
                        <h3 class="mb-0 fw-semibold">@Model.TotalUsers</h3>
                    </div>
                </div>
            </div>

            <!-- Doctors -->
            <div class="col-md-6 col-lg-4">
                <div class="card shadow rounded-4 p-3 border-0 d-flex flex-row align-items-center">
                    <div class="icon-box bg-success text-white rounded-circle d-flex align-items-center justify-content-center me-3" style="width:70px; height:70px;">
                        <i class="bi bi-person-badge-fill fs-3"></i>
                    </div>
                    <div>
                        <h6 class="mb-1 text-muted">Doctors</h6>
                        <h3 class="mb-0 fw-semibold">@Model.TotalDoctors</h3>
                    </div>
                </div>
            </div>

            <!-- Patients -->
            <div class="col-md-6 col-lg-4">
                <div class="card shadow rounded-4 p-3 border-0 d-flex flex-row align-items-center">
                    <div class="icon-box bg-danger text-white rounded-circle d-flex align-items-center justify-content-center me-3" style="width:70px; height:70px;">
                        <i class="bi bi-hospital-fill fs-3"></i>
                    </div>
                    <div>
                        <h6 class="mb-1 text-muted">Patients</h6>
                        <h3 class="mb-0 fw-semibold">@Model.TotalPatients</h3>
                    </div>
                </div>
            </div>

            <!-- Appointments -->
            <div class="col-md-6 col-lg-4">
                <div class="card shadow rounded-4 p-3 border-0 d-flex flex-row align-items-center">
                    <div class="icon-box bg-warning text-dark rounded-circle d-flex align-items-center justify-content-center me-3" style="width:70px; height:70px;">
                        <i class="bi bi-calendar-check-fill fs-3"></i>
                    </div>
                    <div>
                        <h6 class="mb-1 text-muted">Appointments</h6>
                        <h3 class="mb-0 fw-semibold">@Model.TotalAppointments</h3>
                    </div>
                </div>
            </div>

            <!-- Departments -->
            <div class="col-md-6 col-lg-4">
                <div class="card shadow rounded-4 p-3 border-0 d-flex flex-row align-items-center">
                    <div class="icon-box bg-info text-white rounded-circle d-flex align-items-center justify-content-center me-3" style="width:70px; height:70px;">
                        <i class="bi bi-building fs-3"></i>
                    </div>
                    <div>
                        <h6 class="mb-1 text-muted">Departments</h6>
                        <h3 class="mb-0 fw-semibold">@Model.TotalDepartments</h3>
                    </div>
                </div>
            </div>

        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.js"></script>


    <!-- Charts Section -->
    <div class="row mt-4">
        <!-- Line Chart -->
        <div class="col-lg-6 mb-3">
            <div class="card shadow-sm rounded-4 p-2">
                <h6 class="fw-bold text-primary mb-2">📈 Patients Growth (Monthly)</h6>
                <canvas id="patientsChart" style="height:250px;"></canvas>
            </div>
        </div>

        <!-- Pie Chart -->
        <div class="col-lg-6 mb-3">
            <div class="card shadow-sm rounded-4 p-2">
                <h6 class="fw-bold text-success mb-2">🩺 Appointments by Department</h6>
                <canvas id="appointmentsChart" style="height:250px;"></canvas>
            </div>
        </div>

        <!-- Bar Chart -->
        <div class="col-lg-12 mb-3">
            <div class="card shadow-sm rounded-4 p-2">
                <h6 class="fw-bold text-warning mb-2">💰 Revenue Analysis (Quarterly)</h6>
                <canvas id="revenueChart" style="height:280px;"></canvas>
            </div>
        </div>
    </div>

</div>



<script>
    document.addEventListener("DOMContentLoaded", function () {
        fetch('/Dashboard/GetChartData')
            .then(res => res.json())
            .then(data => {
                // Patients Growth Line Chart
                new Chart(document.getElementById('patientsChart'), {
                    type: 'line',
                    data: {
                        labels: data.patientsGrowth.map(x => x.Month),
                        datasets: [{
                            label: 'Patients',
                            data: data.patientsGrowth.map(x => x.Count),
                            borderColor: 'blue',
                            fill: false
                        }]
                    }
                    options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            plugins: { legend: { display: true } }
                     }

                });

                // Appointments by Department Pie Chart
                new Chart(document.getElementById('appointmentsChart'), {
                    type: 'pie',
                    data: {
                        labels: data.appointmentsByDept.map(x => x.Department),
                        datasets: [{
                            data: data.appointmentsByDept.map(x => x.Count),
                            backgroundColor: ['#36A2EB', '#FF6384', '#FFCE56', '#4BC0C0']
                        }]
                    }
                    options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            plugins: { legend: { display: true } }
                     }
                });

                // Revenue Analysis Bar Chart
                new Chart(document.getElementById('revenueChart'), {
                    type: 'bar',
                    data: {
                        labels: data.revenueAnalysis.map(x => x.Quarter),
                        datasets: [{
                            label: 'Revenue',
                            data: data.revenueAnalysis.map(x => x.Revenue),
                            backgroundColor: 'orange'
                        }]
                    }
                    options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            plugins: { legend: { display: true } }
                     }
                });
            });
    });
</script>

